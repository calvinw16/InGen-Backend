APP_NAME=Aido Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./telemetry.db
DETECTOR_BACKEND=stub
YOLO_MODEL=yolo11n.pt

INFERENCE_QUEUE_DEPTH=4
INFERENCE_TIMEOUT_SECONDS=2.0
RETRY_AFTER_SECONDS=1

YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_NMS_IOU_THRESHOLD=0.7
YOLO_MAX_DETECTIONS=300
# Expose per-frame stage measurements in GET response headers for benchmarking.
LATENCY_METRICS_ENABLED=false

STATE_ASSOCIATION_THRESHOLD=0.15
STATE_STALE_SECONDS=5
STATE_EVICTION_SECONDS=30
STATE_MAX_ENTITIES=256

STATE_HISTORY_LIMIT=100
STATE_HISTORY_SECONDS=3600
FARI_STATE_HISTORY_SECONDS=60
FRAME_RETENTION_SECONDS=3600
FARI_FRAME_RETENTION_SECONDS=60

MAX_CAPTURE_AGE_SECONDS=86400
PURGE_INTERVAL_SECONDS=30
PURGE_DRY_RUN=false
