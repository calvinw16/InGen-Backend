APP_NAME=Aido Backend
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/aido
DETECTOR_BACKEND=stub
YOLO_MODEL=yolo11n.pt

INFERENCE_QUEUE_DEPTH=4
INFERENCE_TIMEOUT_SECONDS=2.0
RETRY_AFTER_SECONDS=1

YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_NMS_IOU_THRESHOLD=0.7
YOLO_MAX_DETECTIONS=300
# Expose per-frame stage measurements in GET response headers for benchmarking.
LATENCY_METRICS_ENABLED=false
